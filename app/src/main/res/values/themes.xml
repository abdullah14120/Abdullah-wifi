<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- الثيم الأساسي للتطبيق -->
    <style name="Theme.WiFiBridge" parent="android:Theme.Material.Light.NoActionBar">
        <!-- لون شريط الحالة (الساعة والبطارية) في أعلى الشاشة -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        
        <!-- لون خلفية التطبيق أثناء التحميل -->
        <item name="android:windowBackground">@color/background_light</item>
        
        <!-- لون شريط التنقل السفلي (أزرار الرجوع والهوم) -->
        <item name="android:navigationBarColor">@color/white</item>
        
        <!-- جعل أيقونات شريط الحالة داكنة لتناسب الخلفية الفاتحة -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
